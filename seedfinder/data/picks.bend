def variant_picks(+i: U32) -> List<&2, U32>:
  Blob.row(variant_picks_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def variant_picks_at(+i: U32, +j: U32) -> U32:
  Blob.row_at(variant_picks_chunk((i >> 5n : U32)), (i .&. 31 : U32), j)

