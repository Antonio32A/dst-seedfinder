      "𐀄𐀌𨠠񑥥񱵉𐀃𐀇𩐤𑤨𐀄𐀉𡁡񚅆𐀅𐀄𐀋𠰠񉥄𑔨𐀄𐀌𠰠񉥄񩔨𐀄𐀊𰰠񒣂𐂩𐀄𐀋𰰠񒣂𒲩𐀃𐀇𲀦𑵉𐀄𐀉𡢁񢕨𐀇𐀄𐀊񀠠񚳤𐄊𐀅𐀍𡀥񈃋𪤨𐀌𐀄𐀌𡀥񈃋𪤨𐀄𐀌𰡠𚅦񱵉𐀃𐀇𱰥𑤨𐀄𐀉𡒁񚅇𐀆𐀄𐀊𹀠񒣢𐃉𐀄𐀌𡀠𩵅񩤨𐀄𐀋𡀠𩵅𑤨𐀃𐀇𪀦𑵪𐀄𐀉񑡡񊵌𐀂𐀄𐀋񀠠񢔌𐳫𐀅𐀍񰰤񊣈𒲩𐀂𐀄𐀋񰠠񢂆𐳫𐀄𐀌񰰤񊣈𠅥𐀄𐀌񰠠񚅆𩵥𐀃𐀇𩰥𑥉𐀄𐀉񉑡񂤫𐀂𐀄𐀋𸠠񚃋𐳪𐀄𐀌񨰠񑴥𡥄𐀄𐀊𸠠񢕦𐁧𐀄𐀋񨰠𱴥𐣊𐀃𐀇𲀧𒕪"
    case 71:
      "𐀄𐀉񙲁񒵌𐀂𐀄𐀊񈠠񪦉𐂈𐀅𐀍񱀥񒣠𪳉𐀂𐀄𐀌񰡠񚂧𰕪𐀄𐀌񰡠񢄧𰕦𐀃𐀇𱰦𒅉𐀄𐀉񑢁񊤫𐀂𐀄𐀊񁀠񢕨𐁇𐀄𐀌񩀠񙴆𠵅𐀄𐀋񀡠񘔋𑃪𐀃𐀇𢐧𒅦𐀄𐀉񈡤񩤡𐀈𐀄𐀋𠲅񢄧𐕦𐀅𐀍𠲅񒓠𚳊𐀌𐀄𐀋𠲅񒓠𐕦𐀄𐀌𠲅񒓠񰕦𐀄𐀌𠲅񢄧񰕦𐀃𐀇𚀆𑵅𐀄𐀉񀑃񡔀𐀇𐀄𐀋𘡤񙴆𐅅𐀄𐀌𘡤񙴆񨅅𐀄𐀊𘡤𹴆𐀊𐀄𐀋𘡤𹴆𒰊𐀃𐀇𢐧𒅆𐀄𐀉񈡤񡠩𐀈𐀄𐀊𠲅񂔇𐀪𐀅𐀍𠲅񐃫𚣉𐀌𐀄𐀌𠲅񐃫𚣉𐀄𐀌𠲅񚅧񰕆𐀃𐀇𚀆𑴥𐀄𐀉񀑃񙐈𐀇𐀄𐀊𘡤𺃦𐀉"
    case 72:
      "𐀄𐀌𘡤񑵆񨄥𐀄𐀋𘡤񑵆𐄥𐀃𐀇𢀧𒖆𐀄𐀉񈑤񓃉𐀂𐀄𐀋񘲅񂤇𐠬𐀅𐀍𐲅񒓫𛃊𐀂𐀄𐀋𐲅񂄧𐠬𐀄𐀌𐲅񒓫𠖆𐀄𐀌񘲅񢅧𠖆𐀃𐀇𙰆𒅥𐀄𐀉񀁃񊲨𐀁𐀄𐀋񐡤𺓦𐐋𐀄𐀌񐡤񙵆𘅥𐀄𐀊񐡤񩓦𐀠𐀄𐀋񐡤𹵆𐐋𐀄𐀉𙱤񒳉𐀂𐀄𐀊񈲅񩤉𐁁𐀅𐀍񰲅񒣠𚳉𐀂𐀄𐀌񰲅񚃠𠕦𐀄𐀌񰲅񢄧𠕦𐀄𐀉𑡃񊢨𐀁𐀄𐀊񀡤񡓨𐀠𐀄𐀌񨡤񙴆𘅅𐀄𐀋񨡤𹴆𐐊𐀄𐀊𨠠񉢤𐄨𐀄𐀉𰰠񑳅𐀉𐀂𐀃𒂧𐀂𐀄𡓨𐀃𐀇𠓤𑓈𐀃𐀈𡓤𘄃𐀃𐀈𠓤𹤃𐀄𐀉𩠧𒂤𐀂"
    case 73:
      "𐀃𐀈𡐄񁴃𐀂𐀃𑢠𐀂𐀄񁐈𐀃𐀇𠐄𑓈𐀃𐀈񀐄𹴃𐀃𐀈񁐄𠔃𐀃𐀈񈠠𩢤𐀄𐀉𨣠𙤄𐀅𐀃𐀈񑀃𹳂𐀃𐀈񑀃𸓂𐀂𐀃𑑠𐀂𐀄𸰆𐀃𐀇񀠠𐲤𐀃𐀆𱑠𐀦𐀃𐀆𰡠𐂦𐀂𐀃𑓀𐀂𐀄𩠅𐀃𐀆𰰠𐂦𐀃𐀆𰣀𐁥𐀂𐀄𸰠𐀄𐀊𨠠񊒤𐃈𐀄𐀊𨣀񐒧𐄤𐀄𐀉𨣈𰂧𐀉𐀄𐀉𨠧𰂨𐀉𐀄𐀉𨠠񉢤𐀉𐀃𐀈񑠄𩑇𐀃𐀈񑁦񘓥𐀄𐀊𨠠񉓄𐄨𐀃𐀅𩁁𐀅𐀃𐀆𰠠𐂣"
    case _:
      ""

def pick_lists(+i: U32) -> List<&2, U32>:
  Blob.row(pick_lists_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def digits(c: Nat, +u: U32, tail: List<&2, U32>) -> List<&2, U32>:
  match c:
    case 0n:
      tail
    case 1n+p:
      (u .&. 31 : U32) <> digits(p, (u >> 5n : U32), tail)

def unpack(xs: List<&2, U32>, +n: Nat) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+u, rest}:
      digits(Nat.min(n, 4n), u, unpack(rest, Nat.sub(n, 4n)))

def unpack_list(xs: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+n, rest}:
      unpack(rest, U32.to_nat(n))

# pickspawnprefab's items order for a distribute variant on a tile class: indices into the variant's entries.
def pick(+variant: U32, +class: U32) -> List<&2, U32>:
  unpack_list(pick_lists(Blob.at(variant_picks(variant), class)))
