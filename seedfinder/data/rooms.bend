def weight_of_number(+number: U32, +id: U32) -> U32 & U32:
  match number:
    case 757748:
      B757748Rooms.weight(id)
    case _:
      B756039Rooms.weight(id)

def weight(+build: Builds.Build, +id: U32) -> U32 & U32:
  match build:
    case Builds.Build{+number}:
      weight_of_number(number, id)
