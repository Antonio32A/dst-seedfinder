  4

def swappables_chunk(+c: U32) -> List<&2, String>:
  match c:
    case 0:
      ["𐀋𐆜𐅛", "𐀛𐄆𐃼", "𐀌𐆜𐅛", "𐀮𐄆𐄉"]
