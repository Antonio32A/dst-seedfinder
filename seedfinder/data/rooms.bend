    case _:
      Nil{}

def maptags(+i: U32) -> List<&2, U32>:
  Blob.row(maptags_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row cave story room (data/cave_story.bend's room ids, sorted by name bytes): its row in this module.
