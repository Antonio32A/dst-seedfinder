      "𐀀𐀀𐀀𐀀𐀇𐀀𐀁𐀀𐀀𐀛􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐀛􏿿𐀁𐀀𐀀𐀇𐀀𐀁𐀀𐀀𐂏􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐂏􏿿𐀁𐀊𐀁𐀂𐀀𐀀𐁌􏿿𐀁𐁢􏿿𐀁𐀊𐀁𐀂𐀀𐀀𐁌􏿿𐀁𐁢􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐁧􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐁧􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐂎􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐂎􏿿𐀁𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀊𐀁𐀂𐀀𐀀𐂉􏿿𐀁𐅺􏿿𐀁𐀊𐀁𐀂𐀀𐀀𐂉􏿿𐀁𐅺􏿿𐀁𐀀𐀀𐀀𐀀"
    case 3:
      "𐀀𐀀𐀇𐀀𐀁𐀀𐀀𐂊􏿿𐀁𐀇𐀀𐀁𐀀𐀀𐂊􏿿𐀁𐀀𐀀𐀊𐀁𐀀𐀀𐀀𐀶􏿿𐀁𐀵𐀀𐀁𐀊𐀁𐀀𐀀𐀀𐀵􏿿𐀁𐀶𐀀𐀁𐀀𐀀𐀀𐀀𐀐𐀂𐀀𐀀𐀀𐁤􏿿𐀁𐂀𐀂𐀁𐂁􏿿𐀁𐂖𐀀𐀁𐀐𐀂𐀀𐀀𐀀𐂖􏿿𐀁𐂀𐀂𐀁𐂁􏿿𐀁𐁤𐀀𐀁𐀐𐀂𐀃𐀀𐀀𐁅𐀃𐀁𐀙􏿿𐀁𐀚􏿿𐀁𐂓􏿿𐀁𐀐𐀂𐀃𐀀𐀀𐁅𐀃𐀁𐀙􏿿𐀁𐀚􏿿𐀁𐂓􏿿𐀁𐀐𐀂𐀃𐀀𐀀𐁏𐀃𐀁𐁣􏿿𐀁𐂱􏿿𐀁𐁉􏿿𐀁𐀐𐀂𐀃𐀀𐀀𐁏𐀃𐀁𐁣􏿿𐀁𐂱􏿿𐀁𐁉􏿿𐀁𐀊𐀁𐀀𐀀𐀀𐁖􏿿𐀁𐂳𐀀𐀁𐀊𐀁𐀀𐀀𐀀𐂳􏿿𐀁𐁖𐀀𐀁𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀"
    case 4:
      "𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀"
    case _:
      ""

def room_countstaticlayouts_layout(+i: U32) -> List<&2, U32>:
  Blob.row(room_countstaticlayouts_layout_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row id: weight id, then the choices (string ids) in pairs() order.
def swappables_count() -> U32:
  4

def swappables_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀃𐀋𐆜𐅛𐀃𐀛𐄆𐃼𐀃𐀌𐆜𐅛𐀃𐀮𐄆𐄉"
    case _:
      ""

def swappables(+i: U32) -> List<&2, U32>:
  Blob.row(swappables_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row id: a distribute weight as f64 bits (4 units).
def weights_count() -> U32:
  49

def weights_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀄𓻿𗔐𔵕𑵩𐀄𓼚𓛢𞬜𔌭𐀄𓽐𖉍𝋱𚧼𐀄𓽠𖉍𝋱𚧼𐀄𓽤𗫡𔞮𑑻𐀄𓽨𙍴𛱪𗻺𐀄𓽰𖉍𝋱𚧼𐀄𓽴𗫡𔞮𑑻𐀄𓾀𖉍𝋱𚧼𐀄𓾄𗫡𔞮𑑻𐀄𓾎𛡑𞮅𑺸𐀄𓾔𗫡𔞮𑑻𐀄𓾙𙦙𙦙𙦚𐀄𓾞𛡑𞮅𑺸𐀄𓾤𗫡𔞮𑑻𐀄𓾩𙦙𙦙𙦚𐀄𓾮𛡑𞮅𑺸𐀄𓾴𗫡𔞮𑑻𐀄𓾷𐨽𗂣𝜊𐀄𓾸𕇫𘔞𛡒𐀄𓾹𙦙𙦙𙦚𐀄𓾼𚰈𓄦𞥹𐀄𓿃𓌳𓌳𓌳𐀄𓿄𗫡𔞮𑑻𐀄𓿉𙦙𙦙𙦚𐀄𓿎𛡑𞮅𑺸𐀄𓿐𐀀𐀀𐀀𐀄𓿓𓌳𓌳𓌳𐀄𓿔𗫡𔞮𑑻𐀄𓿕𑺸𕇫𘔟𐀄𓿕𔿟𓭤𕨝𐀄𓿙𙦙𙦙𙦚"
    case 1:
      "𐀄𓿠𐀀𐀀𐀀𐀄𓿣𓌳𓌳𓌳𐀄𓿥𑺸𕇫𘔟𐀄𓿦𖙦𖙦𖙦𐀄𓿨𐀀𐀀𐀀𐀄𓿩𙦙𙦙𙦚𐀄𓿰𐀀𐀀𐀀𐀄𓿴𐀀𐀀𐀀𐀄𓿸𐀀𐀀𐀀𐀄𔀀𐀀𐀀𐀀𐀄𔀀𒣵𜊏𕰩𐀄𔀈𐀀𐀀𐀀𐀄𔀐𐀀𐀀𐀀𐀄𔀔𐀀𐀀𐀀𐀄𔀘𐀀𐀀𐀀𐀄𔀠𐀀𐀀𐀀𐀄𔀤𐀀𐀀𐀀"
    case _:
      ""

def weights(+i: U32) -> List<&2, U32>:
  Blob.row(weights_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row i (tags sorted by string id): tag string id, closure id, kind of the first call (0 none, 1 TAG, 2 GLOBALTAG, 3 ITEM, 4 STATIC), 1 if a second call on the same tagdata returns nothing (one-shot), n, then the n possible values: string ids, or for Terrarium_Spawner the layouts, value k = math.random(n) = k + 1; a numeric TAG value is stored as NONE followed by the number. Values are layouts for STATIC, string ids otherwise.
def maptags_count() -> U32:
  21

def maptags_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀆𐀝𐀹𐀃𐀁𐀁𐅥𐀆𐀞𐀺𐀃𐀁𐀁𐅦𐀆𐀪𐀷𐀄𐀁𐀁𐀃𐀆𐀻𐀵𐀄𐀁𐀁𐀌𐀆𐁂𐀲𐀃𐀁𐀁𐃳𐀆𐁔𐀰𐀁𐀀𐀁𐁔𐀆𐁚𐀮𐀁𐀀𐀁𐁚𐀆𐁛𐀯𐀁𐀀𐀁𐁛𐀆𐁨𐀶𐀄𐀁𐀁𐁛𐀆𐁽𐀻𐀁𐀀𐀁𐁽𐀆𐂝𐀭𐀁𐀀𐀁𐂝𐀆𐂪𐀳𐀄𐀁𐀁𐁋𐀆𐂫𐀸𐀄𐀁𐀁𐀍𐀈𐂯𐀴𐀄𐀁𐀃𐁎𐁍𐁌𐀇𐂰𐀱𐀁𐀀𐀁􏿿𐀁𐀆𐅅𐁁𐀁𐀀𐀁𐅅𐀆𐅶𐀾𐀁𐀀𐀁𐅶𐀆𐅿𐀿𐀁𐀀𐀁𐅿𐀆𐆀𐀽𐀁𐀀𐀁𐆀𐀆𐆁𐁀𐀁𐀀𐀁𐆁𐀆𐆷𐀼𐀁𐀀𐀁𐆷"
    case _:
      ""

def maptags(+i: U32) -> List<&2, U32>:
  Blob.row(maptags_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def start_room() -> U32:
  17

# The start node (depth 1, spawnpoint removed by AddStartingSetPiece): row 0 countprefabs keys in pairs() order, row 1 the generate_these order.
def start_countprefabs_count() -> U32:
  2

def start_countprefabs_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀁𐇧𐀁𐇧"
    case _:
      ""

def start_countprefabs(+i: U32) -> List<&2, U32>:
  Blob.row(start_countprefabs_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def row_of(+room: U32, +depth: U32) -> U32:
  (((room * 2 : U32) + depth : U32) - 1 : U32)

def name(+room: U32) -> U32:
  Blob.at(rooms(room), 0)

def value(+room: U32) -> U32:
  Blob.at(rooms(room), 1)

def node_type(+room: U32) -> U32:
  Blob.at(rooms(room), 2)

def flags(+room: U32) -> U32:
  Blob.at(rooms(room), 3)

def has(+room: U32, +flag: U32) -> Bool:
  U32.is_ne((flags(room) .&. flag : U32), 0)

# distributepercent as f64 (hi, lo).
def distribute_percent(+room: U32) -> U32 & U32:
  Blob.f64(rooms(room), 4)

# math.random() < distributepercent holds exactly when the PCG output is below this.
def distribute_threshold(+room: U32) -> U32:
  Blob.word(rooms(room), 8)

def internal_type(+room: U32) -> U32:
  Blob.at(rooms(room), 10)

def random_node_exit_weight(+room: U32) -> U32:
  Blob.at(rooms(room), 11)

def random_node_entrance_weight(+room: U32) -> U32:
  Blob.at(rooms(room), 12)

# A distribute weight as f64 (hi, lo).
def weight(+id: U32) -> U32 & U32:
  Blob.f64(weights(id), 0)
