    case _:
      ""

def task_room_choices(+i: U32) -> List<&2, U32>:
  Blob.row(task_room_choices_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row closure: [0, a, b, c, 0] meaning a + math.random(b) - c, with U32 wrap-around when c exceeds a.
def count_closures_count() -> U32:
  6

def count_closures_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀅𐀀𐀂𐀂𐀀𐀀𐀅𐀀𐀁𐀂𐀀𐀀𐀅𐀀𐀀𐀂𐀀𐀀𐀅𐀀𐀄𐀂𐀀𐀀𐀅𐀀𐀀𐀂𐀁𐀀𐀅𐀀𐀂𐀂𐀀𐀀"
    case _:
      ""

def count_closures(+i: U32) -> List<&2, U32>:
  Blob.row(count_closures_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row 0: the start_node rooms of the caves start location in order.
def start_rooms_count() -> U32:
  1

def start_rooms_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀊𐀽𐁀𐀿𐁒𐁌𐁋𐁍𐀪𐀰𐀯"
    case _:
      ""

def start_rooms(+i: U32) -> List<&2, U32>:
  Blob.row(start_rooms_chunk((i >> 5n : U32)), (i .&. 31 : U32))

