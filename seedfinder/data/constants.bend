    case 14:
      "𐀈𔁲𖮕𖿱𒹖𔁥𖵵𔡪𛗕𐀈𔁳𝋰𔅗𒯁𔁢𖡴𞇍𚇓𐀈𔁅𛵁𒋊🔅𔁙𜜄𓺙𑰑𐀈𔀾𒜷𜯚𙳟𔁴𔹂𕄐𝤉𐀈𔁴𒪜𝽋𔩳𔁳𑆥𗆻𔚖𐀈𔁘𒯬𖓶𒾲𔁫𗇕𐲩𜝓𐀈𔀷𕮤𚪛𖺒𔁹𝈉𕇀𚠥𐀈𔁫𑙾𗮫𙧺𔁶🧏𛩶𘜿𐀈𔁀𓿫𝽺🾯𔁙𛜀𚃊𕰃𐀈𔁱𔯹𔏠𔿥𔁳🸣𔬯𙢍𐀈𔀀𗯐𗸑𞽂𔀤𙙠🋾𕦃𐀈𔁏𔷘𑑹𓝠𔁹𘕸𞰍𑗣𐀈𔀅🍿𞛧𜷿𔁱𓨊𞣛𖠬𐀈𔁨𛹍𞝁𛤸𔁯𔎂𔃂𔸊𐀈𔁐🫢𒎇𞮈𔁝𛛭𒪊𝮵𐀈𔁴𚚊𕻣𛨪𔁧𖨅𞚚𚠘𐀈𔁵𚝨𙐝𑶢𔁶🀷𕤙𜃝𐀈𔁹𙑟𐖾𙅼𔁴𖥍𙫫𚔶𐀈𔁳𙀧𚚜𘂞𔁜𝈭𓵄𜢵𐀈𔁵𝠭𗌞𖂵𔀹𑽉𐃢𗴤𐀈𔁢𚌗𕰡𘱝𔁗𐏏𜻸𐼿𐀈𔀛𝣖𔕟𖍙𔁲𜸑𐠻🡄𐀈𔁪𙬶𒉱𚳘𔁟𒥟𙆘𚕾𐀈𔁕𐮽𐩁𚻵𔁨𑅏𓵕𔔽𐀈𔁮𕱸𚽖🇤𔁋𚄽𔷑𘓶𐀈𔁡𘗝𒪑𝝵𔁶𘤁𒧥𒐅𐀈𔁟𘧂𗁍𒜊𔁚𛺃𗉆🨎𐀈𔁟𗏎𑎳𜼸𔁞𜜃𓲀𙰍𐀈𔁱𐋫𑬊𒮬𔁐𚓶𙇚𑏚𐀈𔁵𓹖𞟂🥜𔀕𓆞𚵬𜙻𐀈𔁵𐴢𙽅𛒋𔁳𕍖𔛔𖵙𐀈𔁬🊀𗐚𜨁𔁤𐬨𒓤𒲡"
    case 15:
      "𐀈𔁖𖵩𜻲𛖨𔁇𒔠𚉝𙒃𐀈𔁮𔵣𙛨𛖏𔁯𛶕𜿼𓙗𐀈𔁧𞮋𞗿𞸯𔁬𙀸𗉛𐃡𐀈𔁬𞎦𞏨𘺜𔁱𜳝𞖚𙍸𐀈𔁳𓒝𚷹𙉷𔁨𛿄𙢘𓼓𐀈𔁴𜾅𖰨𓸕𔁢𘷺𞈢𓟬𐀈𔁞𕫐𛷱𞭃𔁰𚆡𞏿𞚇𐀈𔁭𗧙𝒰𖝨𔁴𚒁𑡪𝈄𐀈𔁺𓈓𜹥𔡏𔁝𑊌𝞋𔨳𐀈𔀻𒶡𘗼𛚆𔁷𓇞𙝳𔝻𐀈𔀘𚔍𞲪𙐷𔁴𛧘𞇉𞝤𐀈𔁪𒯽🵒𒿸𔁬𙤐𙁱𖑃𐀈𔁸𝔼𐭃𙓰𔁹𔓒𗡜𗍊𐀈𔁀𐾸𓿓𓻡𔁩𐗻𐨪𝟬𐀈𔁺𕥭𜔍𜖷𔁰𖄇𘀳𔐞𐀈𔁹𗕥𔌄𕖕𔁷𗃉𓺎𐌥𐀈𔁰🩞𝓥𐥻𔁩𕺾𗪉🫺𐀈𔀲𗑥𔺹𝆖𔀹𖲾𔿑𛋹𐀈𔁳𐠳𙌵𐃎𔁓𕏔🮕𜽔𐀈𔁴𔽎𚘮𕴺𔁕𓰈𕣍𗀡𐀈𔁐𞩝𛔵𚥷𔁹𚻻𜺾𗯰𐀈𔁲𑩽𚫓𘧷𔁳🖲𓭸𛛉𐀈𔁁𑈬𜏛𔢳𔁵𗃾𜪆𔏻𐀈𔁯😪𘰳𕢪𔁝𔆲𖔩𘛊𐀈𔁳𗵘𙬞🕢𔁴𐙳𜶾🧏𐀈𔀦𛨹𜠲𞣧𔁲𐏐𗜀𔽂𐀈𔁴𚣣𔫇𔎍𔁆𐽎𖘩𓴹𐀈𔀵𔇓𜕥𐝏𔁣𒦒𘚡𚙊𐀈𔁬𗏩🈛𐾨𔀿𖳳𚑙𛏏𐀈𔁝🋃𙳜𔬎𔁹𜂹𛌵𔋧𐀈𔁰𙝗𖤤𛵝𔁪𛘲𜶯𑣋𐀈𔁀𝙑𘸧𕥆𔁲𗎢𗄛𐺉"
    case _:
      ""

def kk_positions(+i: U32) -> List<&2, U32>:
  B.row(kk_positions_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def blur_kernel_size() -> U32:
  15

def blur_sigma_bits() -> U32:
  1077936128

# Row 0: GenerateBlendedMap's 1-D kernel (kernelSize 15, sigma 3.0f) as f32 bits, 2 units each.
def blur_kernel_count() -> U32:
  1

def blur_kernel_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀞𓰏𓓚𓲓𖹫𓴇𝇇𓵟𞶫𓶥𒽲𓷚𑎔𓸀𝀿𓸈𒰛𓸀𝀿𓷚𑎔𓶥𒽲𓵟𞶫𓴇𝇇𓲓𖹫𓰏𓓚"
    case _:
      ""

def blur_kernel(+i: U32) -> List<&2, U32>:
  B.row(blur_kernel_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row i: layout type (1 CIRCLE_EDGE, 2 CIRCLE_RANDOM), count n, then n positions (x, y f64 bits) in generation order (CIRCLE_RANDOM's Randomize shuffle not applied).
def circles_count() -> U32:
  3

def circles_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐁒𐀁𐀊𓿢𜼣𐑵𕩞𓿩𞍷𙮗💨𓿮𖼎𑍄𕓿𓿓𜛯𓜯𞥐𓿮𖼎𑍄𕔀𛿓𜛯𓜯𞥎𓿢𜼣𐑵𕩟𛿩𞍷𙮗💧𓲡𚘦𓌔𕰇𛿰𐀀𐀀𐀀𛿢𜼣𐑵𕩝𛿩𞍷𙮗💩𛿮𖼎𑍄𕓿𛿓𜛯𓜯𞥒𛿮𖼎𑍄𕔀𓿓𜛯𓜯𞥌𛿢𜼣𐑵𕩠𓿩𞍷𙮗💧𛲱𚘦𓌔𕰇𓿰𐀀𐀀𐀀𐁺𐀁𐀏𓿚𐟹𒄆𑫐𓿭𓯃𚻿𗾕𓿧𜟗𚠳𛻁𓿥𖦄𙛢𐯘𓿮𖼎𑍄𕓿𓿓𜛯𓜯𞥐𓿯𝌟𙓸𖟇𛾺𜉠𙬼𕝢𓿫𛙺𞡘𔲫𛿟🿿🿿🿼𓿢𜼣𐑵𕩟𛿩𞍷𙮗💧𓿊𙳙𚱂𕤄𛿯𔳼𓉺𐁿𛿊𙳙𚱂𕣬𛿯𔳼𓉺𐂀𛿢𜼣𐑵𕩝𛿩𞍷𙮗💩𛿫𛙺𞡘𔲨𛿠𐀀𐀀𐀄𛿯𝌟𙓸𖟆𛾺𜉠𙬼𕞣𛿮𖼎𑍄𕔀𓿓𜛯𓜯𞥌𛿧𜟗𚠳𛻅𓿥𖦄𙛢𐯔𛿚𐟹𒄆𑫞𓿭𓯃𚻿𗾒𛲱𚘦𓌔𕰇𓿰𐀀𐀀𐀀𐁺𐀂𐀏𛿁𑿞𔪔𔏿𛾽𙒝𝣗𙳌𛿂𜇴𙍔𙖭𓿉𞴆𒧤𔖍𓿇𙀈𚐙𔧵𓿏𕅙𐖄𘿹𓿖𖋹𚈴𝈈𛾪𕚜𑭬𕳕𓿇𖌘𖵱𞣶𛿖𖻸𗷇𜾘𛿄𓔀𗌏𕢒𛿙𜸮🶱𐯚𛿛𖯲𚱼𙳝𛿈𐄛𘮿𖉯𛿞𖓮𕛒𝘨𓿄𐓕𑌉𘝽𛿒𓘾𕝋𙂈𓿜𚐯𛞻𛙱𓾧𚞑𚠨𗳬𓿡𝏍𐐚𒭈𓿘𒵇🝧🌗𓿜𛉁𛗢𔧟𓿢𝐡𛮜🧗𓿅𛠓𜩶𐳮𓿣𙊷𚱄𐕱𛿆🃧𐎲𛔊𓿜𙗬𕵟𕂉𛿟𓤇𖑇𚞡𓿂𜣵𚜽𒺾𛿥𖙏𜱸𞔦"
    case _:
      ""

def circles(+i: U32) -> List<&2, U32>:
  B.row(circles_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row 0: the perlin permutation p[0..255] (p[i + 256] = p[i]), two bytes per unit, the lower index first.
def perlin_count() -> U32:
  1

def perlin_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐂀𚂗𕮉𐽚𐶃𕿉𓕠𞧂𞄇𒒌𑹧𘹅𖌈🀥𐨕𛸗𙐆𗣷𔯪𑨀𓻅🱞𜯛𒍵𒀋𛄹𕠡𙗭𕜸𑒮𘡽𚢫𚽄𚕊𘙇𓂋𚘛𙉍𞞞𖽓𗫥𝌼𞚅𖧜𒥜𒸷𒣵𖛴𓚏𑥁𚄿𝠁𔥐𔳑𛮄𕧐𚤒𜓈𘊇𛱴𕚟𖒤𜙭𛪭𔀃𝤴🫢𗭼𜨅𙌦𗹶𕋿𝑕𜻏𞌻𑀯𑄺𛶶𒨜𛟟𝖪🡷𐊘𙨬𔚣𙧝𙭥𒮧𐦬𑚁🴧𖈓𖹬𗅏𞣠𛦲𖡰🛚𞑡𒋻𜇲𝋮𐲐𛎿🆢𓍑𞮑𐻹𖯯𜀱𑿖𜞵𙵪𕒸𛃌𗥳𒴲𐑿🺖𞲊𕷍𗋞𑵃𔠘𘷳𜎀𔉎𓷗𛒜"
    case _:
      ""

def perlin(+i: U32) -> List<&2, U32>:
  B.row(perlin_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def kk_x(+v: U32) -> U32 & U32:
  B.f64(kk_positions(v), 0)

def kk_y(+v: U32) -> U32 & U32:
  B.f64(kk_positions(v), 4)

def blur_weight(+i: U32) -> U32:
  B.word(blur_kernel(0), (i * 2 : U32))

def perlin_half(odd: Bool, +u: U32) -> U32:
  match odd:
    case True{}:
      (u >> 8n : U32)
    case False{}:
      (u .&. 255 : U32)

# The perlin permutation p[i & 255].
def perlin_p(+i: U32) -> U32:
  +k = (i .&. 255 : U32)
  perlin_half(U32.is_ne((k .&. 1 : U32), 0), B.at(perlin(0), (k >> 1n : U32)))
