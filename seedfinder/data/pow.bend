      "𐀈𓲗𙪦𕶃𗭭𓿯𛕘𖳹𘤏𐀈𓲎𛔚𙋽𞿼𓿯𚲒𒭲𔟷𐀈𓰾𛸽𗀯𙳑𓿯𚏬𓋓𝆢𐀈𛱪𐌴𘦐𖸋𓿯𙭦𚿾𝌛"
    case 3:
      "𐀈𛲕𕙒𒨯𛴎𓿯𙌁𝀒𕭑𐀈𛱐𘃯𘱎𞩕𓿯𘪽𜁬𓇌𐀈𛲑𜤣𛧕🐖𓿯𘊚𚺩𒷠𐀈𓲀𝏣𞥜𕖯𓿯𗪘𜢥𘹑"
    case 4:
      "𐀈𛲀𑬕𞪥𙍈𓿯𗊸𓱽𕅻𐀈𛲏𑿰𕗞𓈽𓿯𖫹𓢌𘷪𐀈𓲋𘦌𓼓𕎿𓿯𖍛𞭯𜭵𐀈𛲖𝦜𗘑𞬦𓿯𕯠𘐄𕳔"
    case 5:
      "𐀈𓲚𞳷𓸺𒽠𓿯𕒇𓅨𛦪𐀈𛲏𞞂𜮆𓢝𓿯𔵐𒋼𝤝𐀈𓲊𖽁𔒦𜎍𓿯𔘻𘡢𘳖𐀈𓲀𗨅𛃤𐑽𓿯𓽉𙅽𝲖"
    case 6:
      "𐀈𓲖𘻽𞎨𚢔𓿯𓡺𖹵𖈸𐀈𓲇𕸘🉴𔡽𓿯𓇎𔾲𚘿𐀈𓲀𔜫𙠟𞟲𓿯𒭅𖗢𗳝𐀈𛲖𛡻𓽱𐡞𓿯𒓟𞇵𖎁"
    case 7:
      "𐀈𓲂🟡𖴉𚬱𓿯𑺝🔟𝻡𐀈𛰽𒆛𑩯𛿺𓿯𑡿𝃚𝦐𐀈𓲋𓞂𗈌𐪴𓿯𑊅𚛤𐌋𐀈𓱮𑒒𘧎𜮏𓿯𐲯𚤾𒽖"
    case 8:
      "𐀈𓲃𔵵𔶰𚮶𓿯𐛾𐨱𛜕𐀈𓲆𔈁𞊬𗑌𓿯𐅰🱌𝠱𐀈𓲏𝴹𕷓🡊𓿮🰈𛉤𑛿𐀈𛲆𚎀𓮎𕬄𓿮🛅𕾒𙿱"
    case 9:
      "𐀈𛲒𔫭𜱋𕁨𓿮🆧𓜺𚧋𐀈𛲙𐟸𑭑𒶎𓿮𞲮𖴅𝡦𐀈𛱱𝇨𓺔𓛒𓿮𞟛𓓥𙿷𐀈𛲙𑤙𛏎𑬕𓿮𞌭𜌓𚣥"
    case 10:
      "𐀈𓲅𙽈𚜪𔱭𓿮𝺦𔰒𓐢𐀈𛲓𑉠𗨨𖦊𓿮𝩅𐒬𘀜𐀈𛱘𚞏𔠗𘥛𓿮𝘊𒇷𒸪𐀈𛱼𒲛𖝉𙨛𓿮𝇵𝥐𚢗"
    case 11:
      "𐀈𓱃𖏭𖃂𚰑𓿮𜸈𖁡𘤭𐀈𓲖𖘉𓬆𖓯𓿮𜩁𞴝𐁗𐀈𓱮𜳡𝪡𐍹𓿮𜚢𛗁𓳐𐀈𓲓🾎𓼏𑈰𓿮𜌪🃗𝏞"
    case 12:
      "𐀈𓱶𙃎𛭺𚾰𓿮𛿚𝔶𒨧𐀈𓲓𑶽𞭔𞁷𓿮𛲲𙧽𝴍𐀈𛲏𙐴𐁱𚎎𓿮𛦲𗚝𒲧𐀈𛲇𝻌𝲓𚍉𓿮𛛚𚋏𖙂"
    case 13:
      "𐀈𛱸𝻆𛴏𓡟𓿮𛐫𕚝𔾂𐀈𛲆𑉆𞱻𕳶𓿮𛆤𜩝𙈏𐀈𓲓𓔅𑣽𝞎𓿮𚽇𓚵𒟚𐀈𓱻𙢷𒾊𙬅𓿮𚴒𝒗𜟽"
    case 14:
      "𐀈𓲐𖏡𞈜𕐉𓿮𚬇𝵈𕐩𐀈𓰴𜞅𕀙𜛪𓿮𚤦𘩙𔚷𐀈𓲔𓋦𒭤𜀵𓿮𚝯𑖭𒅈𐀈𛲌𞑊𖆙𗚟𓿮𚗡𛥶𝰉"
    case 15:
      "𐀈𛲌𓏅𓯯𔶨𓿮𚑾𛀺𕖅𐀈𛲄𕍸𘤫𞦮𓿮𚍆𓓌𜌠𐀈𛲓𜻝𗡖𕡘𓿮𚈸𘉕𒈥𐀈𓱗𑂪𘁾𑥤𓿮𚅕𝑌𚥳"
    case 16:
      "𐀈𛲓𛏯𛽞𒈨𓿮𚂞𖙿𓯍𐀈𛱪𑊭𘜴𛦂𓿮𚀒𗔋𝪿𐀈𛱣𖟯𛡭𚧮𓿮𙾲𓱥𑨯𐀈𛲀𝰽𕓠𘡑𓿮𙽽🥑𙒄"
    case 17:
      "𐀈𛱸𑽤𗹚𓻏𓿮𙽵𞣬𕽴𐀈𛲆𞹊𜂋𗶰𓿮𙾚𔢥𘅴𐀈𛲆𑤲𑹕𞚊𓿮𙿫𕙂𖟉𐀈𓲐𙳋𕸉𝓓𓿮𚁩𔿞𕴿"
    case 18:
      "𐀈𛱻𓋜𛥍𚔝𓿮𚄔𗏫𐆇𐀈𓲔𞳽𕑧𜁫𓿮𚇭𐄰𜄲𐀈𓱥𞯡𚯖𖱕𓿮𚋳𓛏𔹢𐀈𛲈𚇅𒾳𜽂𓿮𚐧𕐾𑨒"
    case 19:
      "𐀈𛲓𖦶🄻𓜴𓿮𚖉𙥌𜸓𐀈𛲀𕺄𓨙🼞𓿮𚜚𔘣𜞭𐀈𛲔𝑐𝡲𕝮𓿮𚣙𙭄𙋭𐀈𓲐𚵧𕬎𘨀𓿮𚫇𝦊𖚙"
    case 20:
      "𐀈𓲍𛜯𜇰𞪴𓿮𚳥𔈪𚃛𐀈𛱥𛙠𙳅𞟿𓿮𚼲𑚵𔒌𐀈𓱻🚃𕧳𕽄𓿮𛆮𙤕𗜶𐀈𛲓𐤟𚜞𓶃𓿮𛑛𐮑🿆"
    case 21:
      "𐀈𛱝𚦸𘭬𑸩𓿮𛜷𛃍𜗥𐀈𛱬𒏹𗲐𛥙𓿮𛩄𜯈𕈏𐀈𛲒𔍃𒋴🦪𓿮𛶂𙿞𔹐𐀈𛲅𜩬𝝦𘹋𓿮𜃱𗃊𐞺"
    case 22:
      "𐀈𓱱𚿼𒮑𜸧𓿮𜒑𘊣🂐𐀈𓱭𝈵𞄊𗎻𓿮𜡣𑧣𒌣𐀈𛲇𜔄𒉢𒉣𓿮𜱦𗭝𞕥𐀈𓲋𑲆𞏢𓇕𓿮𝂛𞱊𒴳"
    case 23:
      "𐀈𛲑𛯑𝎼𛬕𓿮𝔃𛈾𒕝𐀈𓲐𜰱𙳮𓇒𓿮𝦞𑌰𛍘𐀈𓲄𖦄𖹳𕪳𓿮𝹫𕕹🶿𐀈𛲂𝿍𙞎𙶴𓿮𞍫𛿓🍺"
    case 24:
      "𐀈𓲌𑩷𙋋𓎇𓿮𞢟𙥚𝎭𐀈𛲐𗮏𔫑𝧺𓿮𞸇𒦍𛙦𐀈𛱕𜏙𕛜𚺺𓿮🎢𛡏𑗻𐀈𛲐𚐎𓶦🙀𓿮🥲𘷥𕤺"
    case 25:
      "𐀈𛱨𝛴𓢭𙌴𓿮🽶🋻𕹇𐀈𛲑𞻢𖭘𘨵𓿯𐖰𓂡𐙊𐀈𓱴🿗𐩟𝷍𓿯𐰞𙁋𜇒𐀈𛲑𛷻🪒𙢬𓿯𑋂𕯗𑸉"
    case 26:
      "𐀈𓱳𖺮𓂯𐲳𓿯𑦛𝶅𕊜𐀈𓲎𞌲𕲟🶔𓿯𒂫𕿿𝁺𐀈𓲄𞂏𝄉𕦬𓿯𒟱𒹗𝅋𐀈𓱣𜶯𓡎𑩧𓿯𒽭𙐆𞞵"
    case 27:
      "𐀈𓱧𖬬𖲒𑥨𓿯𓜠𝳯𙁩𐀈𛲀𘨘𘏌𛗒𓿯𓼋𕕝𜏺𐀈𛲏𚵝𓿿🩯𓿯𔜭𔨇𘥼𐀈𛲐𐶮𓡵𚥉𓿯𔾇𐠍𘧲"
    case 28:
      "𐀈𓱴𚎅𚘽𐞧𓿯𕠘𝳻𚒇𐀈𛲂𙆞𒁀𒈏𓿯𖃣𑛉𘎘𐀈𓲎𕩐𝗁𙊬𓿯𖧦𐏛𓊅𐀈𓲄𓩙𚰁𖭋𓿯𗌡🌁𛑠"
    case 29:
      "𐀈𛲂𝔡𐞴𓸟𓿯𗲗𓍻𙭟𐀈𛲉𒪹𓭇𐷉𓿯𘙆𑓵𚄩𐀈𓱴𛘄𖀺𘣓𓿯𙀮𞞋𓿶𐀈𓲃𜗬𕆝𗉱𓿯𙩑🯇𔲃"
    case 30:
      "𐀈𛲏🜒𘿓𙇰𓿯𚒯𚊤𙃚𐀈𛲍𚺘𞈣𗑽𓿯𚽈𒶎𖟱𐀈𓲎𜎼𔆪𒀈𓿯𛨛𞹡𕨧𐀈𓲄𒮔𜎩𞬲𓿯𜔫𓝫𛪗"
    case 31:
      "𐀈𓲊𖒩𓇑𘗮𓿯𝁶𕭮𔕀𐀈𛲎𓞺𞐻𞏭𓿯𝯽𚶜𛸔𐀈𓱷𘤻𔶑𜶝𓿯𞟁𘆞𙃘𐀈𓱓𐗁𔅠𜲉𓿯🏂𒮏𗇱"
    case _:
      ""

def glibc_exp_tab(+i: U32) -> List<&2, U32>:
  B.row(glibc_exp_tab_chunk((i >> 2n : U32)), (i .&. 3 : U32))

# Slice i of z: C (c = C / 2^11 ~ 1/z), -ln(c) at 2^-122 (two's complement, 16-bit units, high first).
def win_log_tab_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀉𐭒🺜𘋖𞳖𕟝𗯍𗓐𚹝𘐣𐀉𐭊🺟𕝾𜋥𚑙𑣞𑥂𚱕𖜩𐀉𐭂🺢𒸨𝙤𖊽𘘠𕜸𕫍𐮡𐀉𐬺🺥𐛘𐌲𑰃𒿵🿇𗦒𗾝"
    case 1:
      "𐀉𐬲🺧𞆏𒭍𑼱𞆱𒶏𑲇𐹾𐀉𐬪🺪𛹑𓛤𐘅𚪷𑲻𚹟🻏𐀉𐬣🺭𔄪𓵮𐷃𖲑𞫍𜭖🰷𐀉𐬛🺰𒇈𙼲𐡥𖗼𓻗𞵹𑭳"
    case 2:
      "𐀉𐬓🺳𐑺𖌒𛮢𔄙𕤙𓮤𓙒𐀉𐬌🺵𘲌𓄰𖚈𝎯𜵑𒔉𓓉𐀉𐬄🺸𗌪𖩤𜉮𜠞𖹞𝁋𘗠𐀉𐫼🺻𕯤𛧃𛡇𕰲𐰧𛜿𐻤"
    case 3:
      "𐀉𐫵🺽𞥅𓒐𓚥𘻞𛀑𜉯𔊍𐀉𐫭🻀𝗼𗸹𘁿𔺡𚌈𞼓𒓣𐀉𐫦🻃𖛟𑹍𞯣𝝕𙟴𘦸𜯔𐀉𐫟🻅🥨𒿾𖔭𓾓𖊘𔭂𖯁"
    case 4:
      "𐀉𐫗🻈𞰌𝢤𖷲𖄲𕇰𒱗𓱚𐀉𐫐🻋𘈦𕙸𒪲𙮩𘬁𒌾🂍𐀉𐫉🻎𑧭𐏒𒂘𜰑𘾠𜬲𘉔𐀉𐫁🻑𑊗𔋗𕢁𓯇🸴𖩊𘑔"
    case 5:
      "𐀉𐪺🻓𚷼🬇𝧯𕫧𙞡𘸏𚝥𐀉𐪳🻖𔬖𜩎𛻉𛯇𘧪𛅂𛇷𐀉𐪬🻘𞧦𞰇𚰬𓠧𚩭𓄨🌐𐀉𐪥🻛𘩯𙿴𐣬𓁌𗥽𜃱𑧭"
    case 6:
      "𐀉𐪞🻞𒲳𒩆𙊫𔄵𝅉𕦬𛩴𐀉𐪗🻠𝂳𝎯𑤥𑨑𔮆𘧁𒃠𐀉𐪐🻣𗙳𞥦𖁐𔎗𑢫🱱𑃳𐀉𐪉🻦𑷵𛴺𒧬𖴻𑰔𖣠𘍆"
    case 7:
      "𐀉𐪂🻨𜜻𚖙𖜛𚐀𜬅𝞢𚘪𐀉𐩻🻫𗉇🶠𙊦𛖦𘼘𝰡𐠮𐀉𐩴🻮𑼝𒔦𓒏🄟𙧋𗑾𞪥𐀉𐩭🻰𜶽𘃇𘾚𗍍𝾙𔵝𓣞"
    case 8:
      "𐀉𐩦🻳𗸫𗧵𗥯𓴀𗑜𜒺𒼗𐀉𐩠🻵𜶱𝣆🇊𐣀𘗾𗣿𓱶𐀉𐩙🻸𘅿𙇦𜿭𙔜𚱩𔅕🡄𐀉𐩒🻻𓜡𞞾𑿦𛩑𒳫𘙳𚷊"
    case 9:
      "𐀉𐩌🻽𘬣𞤽𜴌𒻆𐾔𗬏🢤𐀉𐩅🼀𔐳𒍓𖥳𗒜𓅇𙛑𑷧𐀉𐨿🼂𙬨𗬭𙍼𚝣𑐱𓈇𓽇𐀉𐨸🼅𕞭𔶤𒙇𜝁𒐅🳧𙇺"
    case 10:
      "𐀉𐨱🼈𑘒𚊍🰬𜈍𗜍𕗎𚎼𐀉𐨫🼊𗆠𜀵𗗞𑫗𗽒𜾪𔪖𐀉𐨥🼌𜺓𖷄𒟥𐾫𘡯𞨭𞽍𐀉𐨞🼏𙈞𑍪𚦷𓀾𛖐𓯡𕎹"
    case 11:
      "𐀉𐨘🼑🈚🪠𙰔🥧𕳌𞤠𗱆𐀉𐨑🼔𛤶𑿉𓛆𛏔𘱽𜀃𝂩𐀉𐨋🼗𑱅𑴈𗥹𙓧𔻦𒽝𞓏𐀉𐨅🼙𘃁𙢐𗷤𓝆𜘠𑌉𔚃"
    case 12:
      "𐀉𐧿🼛𞚭𔢡𔽱𝤇𙲱𔧷𘨌𐀉𐧸🼞𛒽𕎟𓧺𞞽𜜔𗽭𕿡𐀉𐧲🼡𑷊𘹝𚝩𒿷𐩫𞩢𓇏𐀉𐧬🼣𘡌𗷯𙸫𓌷𚇜𗿑𐋵"
    case 13:
      "𐀉𐧦🼥👄𞖢𚪋🪦𖟥𘍺𕄨𐀉𐧠🼨𖆵𘯺𐁩𓦌🼶𔆘𕆢𐀉𐧚🼪𝂠𓪶𔪂𚓚𕑪𓯬𓡷𐀉𐧔🼭𔄆𛻝𙆘𝳗𘦕𑉱𜛙"
    case 14:
      "𐀉𐧎🼯𛋪𞣃𓮳𓮚𘈤𖛻𞦃𐀉𐧈🼲𒙎𘰐𒏥𕅃𙰟🠾𗭞𐀉𐧂🼴𙬳𗿊𜫮𕓆𘥵𚝁𗩎𐀉𐦼🼷𑆛𙹟𚄎𕔈𘐂𞣧𝮀"
    case 15:
      "𐀉𐦶🼹𘦈𜖩𖥮𘊩𐩮𝋿𙔈𐀉𐦰🼼𐋼𝛹𛝻𗻿𛟴𑆳𔐩𐀉𐦪🼾𗷹𛜡𘚒𓣤𖙃𓞘𚊟𐀉𐦤🽀🪁𔹹𞱡𘏢𗃯𜰷𒲌"
    case 16:
      "𐀉𐦞🽃𗢕𘣬𞙤𔊱𘢹𐩺𖋥𐀉𐦙🽅𘶁𗃰𚊣𙟨𛙦𙗗𜠈𐀉𐦓🽈𐹱𝿿𔝿𗵓𑕮𞉿𝠝𐀉𐦍🽊𙃴𗞖𑹧𙇉𐏎𑯋𔰈"
    case 17:
      "𐀉𐦇🽍𑔋𓆞𑷄𓒎𕖛𜠊🥱𐀉𐦂🽏𒻾🋸𘢘𘮐𘌌𘵈𞅔𐀉𐥼🽑𛗿𜔴𖨶𕈳𔣌𘘳𚺭𐀉𐥷🽓𝉤𑙙𛱋𘣔𑖿𘢘𚡿"
    case 18:
      "𐀉𐥱🽖𕱕𜤧𛹆𕑑𐮻𕼙𚮍𐀉𐥫🽘𞟥𐥘𕙫𖿤𞐹𔢮𓈷𐀉𐥦🽛𐠙𜹶𐲇𚳏𚪫𙕐𐞏𐀉𐥠🽝𙚤𙦤𑜌𜅡𓕸𓰏𐾞"
    case 19:
