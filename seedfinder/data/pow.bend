def win_log_tab(+i: U32) -> List<&2, U32>:
  B.row(win_log_tab_chunk((i >> 2n : U32)), (i .&. 3 : U32))

# Row a + 16: 2^(a/32) at 2^-127.
def win_exp_coarse_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀈𕪂𗦙🳯𓉂𒲾𜓙𛪥𕽐𐀈𕱽𝞣𛅽𜽴𘷃𜮼𒬵𛋑𐀈𕺄𕇏𚰆𑭟𕑀𘿛𓚇𝞽𐀈𖂖𒙥𓌸𔨫𓸢𛺬𝊀𔏛"
    case 1:
      "𐀈𖊳𙔈𚪃𖵮𙼕𖡤𛉮𜾜𐀈𖓜𝻃𓜗𙏑𔁰🲕𐊈𛒿𐀈𖜒𔘊𘿂𔁱🄚𜇇𜫹𖍷𐀈𖥔𐻈🢕𗈭𐤒𔜫𞇯𒀔"
    case 2:
      "𐀈𖮢𗹥𖭎𛕺𑳓𔗜𜠖𙿯𐀈𖷽𝯋𞵹𑮪𙻂𐚭𔼔𝔲𐀈𗁦𖽶𑕊𗂈𘌬𔪂𔛩𙧥𐀈𗋜𘍳𛹁𚑔𐼯𔞥𒝭𝡶"
    case 3:
      "𐀈𗕠𖍳𞺒𑲗𖠖𛫙𛠷𒩽𐀈𗟲𕳍𞹭𗫥𚌫𐹻𔩆𝲉𐀈𗪒𛺊𙉃𖘖𓷎𘘽𗛌𐟢𐀈𗵁𝥭𛤕𐆝𓸒𝶊𑢮𛿦"
    case 4:
      "𐀈𘀀𐀀𐀀𐀀𐀀𐀀𐀀𐀀𐀈𘋍𘚘𚰫𚇗𓸪𔝛𔙒𐯿𐀈𘖪𜍧𜱈𗬔𜗉𕮌𒅔𜆲𐀈𘢘𐺀𙋚𘔧𕷸𝝬𙣆𗕣"
    case 5:
      "𐀈𘮕𜇣𞪋𝛦🯤𖊇𕢥𓲐𐀈𘺤𓦋𔗍𕏀𒷀𑑌𘞃𝓆𐀈𙇃𝍳𚬑𜌶𐿖𝣠𚹚𜧘𐀈𙓴𞾨🻷𐥡𒺊🫑𒕑𝹔"
    case 6:
      "𐀈𙠷🁑𘶸𚥯𔚭𒌘𒹂🛶𐀈𙮍𓦹𝕎𕔸𚊨𑞢𚏌𓼟𐀈𙻵𓉠𙆡𑆭𚂑𑼉𞮹🷑𐀈𚉰𔌃𐱉𖠘𙭺𐓯𘃏𝺨"
    case 7:
      "𐀈𚗾𝚩𛅑𓣪𑲽𗽢𑜐𗀛𐀈𚦡𕪴𞩼𐻸𕐞𒓬𓔱🩳𐀈𚵘𓻪𔊡𔫆𔦀𚣈🖚𒻄𐀈𛄣🖁𝊬𒖏𘟐𓟩𖴡𕶎"
    case 8:
      "𐀈𛔄🌳🧞𖒄𕥽𘦳𗕊𛺟"
    case _:
      ""

def win_exp_coarse(+i: U32) -> List<&2, U32>:
  B.row(win_exp_coarse_chunk((i >> 2n : U32)), (i .&. 3 : U32))

