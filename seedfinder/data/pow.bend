    case 17:
      ["𛱸𑽤𗹚𓻏𓿮𙽵𞣬𕽴", "𛲆𞹊𜂋𗶰𓿮𙾚𔢥𘅴", "𛲆𑤲𑹕𞚊𓿮𙿫𕙂𖟉", "𓲐𙳋𕸉𝓓𓿮𚁩𔿞𕴿"]
    case 18:
      ["𛱻𓋜𛥍𚔝𓿮𚄔𗏫𐆇", "𓲔𞳽𕑧𜁫𓿮𚇭𐄰𜄲", "𓱥𞯡𚯖𖱕𓿮𚋳𓛏𔹢", "𛲈𚇅𒾳𜽂𓿮𚐧𕐾𑨒"]
    case 19:
      ["𛲓𖦶🄻𓜴𓿮𚖉𙥌𜸓", "𛲀𕺄𓨙🼞𓿮𚜚𔘣𜞭", "𛲔𝑐𝡲𕝮𓿮𚣙𙭄𙋭", "𓲐𚵧𕬎𘨀𓿮𚫇𝦊𖚙"]
    case 20:
      ["𓲍𛜯𜇰𞪴𓿮𚳥𔈪𚃛", "𛱥𛙠𙳅𞟿𓿮𚼲𑚵𔒌", "𓱻🚃𕧳𕽄𓿮𛆮𙤕𗜶", "𛲓𐤟𚜞𓶃𓿮𛑛𐮑🿆"]
    case 21:
      ["𛱝𚦸𘭬𑸩𓿮𛜷𛃍𜗥", "𛱬𒏹𗲐𛥙𓿮𛩄𜯈𕈏", "𛲒𔍃𒋴🦪𓿮𛶂𙿞𔹐", "𛲅𜩬𝝦𘹋𓿮𜃱𗃊𐞺"]
    case 22:
