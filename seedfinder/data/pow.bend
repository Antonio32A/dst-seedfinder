    case _:
      Nil{}

def glibc_exp_tab(+i: U32) -> List<&2, U32>:
  Blob.row(glibc_exp_tab_chunk((i >> 2n : U32)), (i .&. 3 : U32))

# Slice i of z: C (c = C / 2^11 ~ 1/z), -ln(c) at 2^-122 (two's complement, 16-bit units, high first).
def win_log_tab_count() -> U32:
  256

def win_log_tab_chunk(+c: U32) -> List<&2, String>:
  match c:
    case 0:
      ["𐭒🺜𘋖𞳖𕟝𗯍𗓐𚹝𘐣", "𐭊🺟𕝾𜋥𚑙𑣞𑥂𚱕𖜩", "𐭂🺢𒸨𝙤𖊽𘘠𕜸𕫍𐮡", "𐬺🺥𐛘𐌲𑰃𒿵🿇𗦒𗾝"]
    case 1:
      ["𐬲🺧𞆏𒭍𑼱𞆱𒶏𑲇𐹾", "𐬪🺪𛹑𓛤𐘅𚪷𑲻𚹟🻏", "𐬣🺭𔄪𓵮𐷃𖲑𞫍𜭖🰷", "𐬛🺰𒇈𙼲𐡥𖗼𓻗𞵹𑭳"]
    case 2:
      ["𐬓🺳𐑺𖌒𛮢𔄙𕤙𓮤𓙒", "𐬌🺵𘲌𓄰𖚈𝎯𜵑𒔉𓓉", "𐬄🺸𗌪𖩤𜉮𜠞𖹞𝁋𘗠", "𐫼🺻𕯤𛧃𛡇𕰲𐰧𛜿𐻤"]
    case 3:
      ["𐫵🺽𞥅𓒐𓚥𘻞𛀑𜉯𔊍", "𐫭🻀𝗼𗸹𘁿𔺡𚌈𞼓𒓣", "𐫦🻃𖛟𑹍𞯣𝝕𙟴𘦸𜯔", "𐫟🻅🥨𒿾𖔭𓾓𖊘𔭂𖯁"]
    case 4:
      ["𐫗🻈𞰌𝢤𖷲𖄲𕇰𒱗𓱚", "𐫐🻋𘈦𕙸𒪲𙮩𘬁𒌾🂍", "𐫉🻎𑧭𐏒𒂘𜰑𘾠𜬲𘉔", "𐫁🻑𑊗𔋗𕢁𓯇🸴𖩊𘑔"]
    case 5:
      ["𐪺🻓𚷼🬇𝧯𕫧𙞡𘸏𚝥", "𐪳🻖𔬖𜩎𛻉𛯇𘧪𛅂𛇷", "𐪬🻘𞧦𞰇𚰬𓠧𚩭𓄨🌐", "𐪥🻛𘩯𙿴𐣬𓁌𗥽𜃱𑧭"]
    case 6:
      ["𐪞🻞𒲳𒩆𙊫𔄵𝅉𕦬𛩴", "𐪗🻠𝂳𝎯𑤥𑨑𔮆𘧁𒃠", "𐪐🻣𗙳𞥦𖁐𔎗𑢫🱱𑃳", "𐪉🻦𑷵𛴺𒧬𖴻𑰔𖣠𘍆"]
    case 7:
      ["𐪂🻨𜜻𚖙𖜛𚐀𜬅𝞢𚘪", "𐩻🻫𗉇🶠𙊦𛖦𘼘𝰡𐠮", "𐩴🻮𑼝𒔦𓒏🄟𙧋𗑾𞪥", "𐩭🻰𜶽𘃇𘾚𗍍𝾙𔵝𓣞"]
    case 8:
      ["𐩦🻳𗸫𗧵𗥯𓴀𗑜𜒺𒼗", "𐩠🻵𜶱𝣆🇊𐣀𘗾𗣿𓱶", "𐩙🻸𘅿𙇦𜿭𙔜𚱩𔅕🡄", "𐩒🻻𓜡𞞾𑿦𛩑𒳫𘙳𚷊"]
    case 9:
      ["𐩌🻽𘬣𞤽𜴌𒻆𐾔𗬏🢤", "𐩅🼀𔐳𒍓𖥳𗒜𓅇𙛑𑷧", "𐨿🼂𙬨𗬭𙍼𚝣𑐱𓈇𓽇", "𐨸🼅𕞭𔶤𒙇𜝁𒐅🳧𙇺"]
    case 10:
      ["𐨱🼈𑘒𚊍🰬𜈍𗜍𕗎𚎼", "𐨫🼊𗆠𜀵𗗞𑫗𗽒𜾪𔪖", "𐨥🼌𜺓𖷄𒟥𐾫𘡯𞨭𞽍", "𐨞🼏𙈞𑍪𚦷𓀾𛖐𓯡𕎹"]
    case 11:
      ["𐨘🼑🈚🪠𙰔🥧𕳌𞤠𗱆", "𐨑🼔𛤶𑿉𓛆𛏔𘱽𜀃𝂩", "𐨋🼗𑱅𑴈𗥹𙓧𔻦𒽝𞓏", "𐨅🼙𘃁𙢐𗷤𓝆𜘠𑌉𔚃"]
    case 12:
      ["𐧿🼛𞚭𔢡𔽱𝤇𙲱𔧷𘨌", "𐧸🼞𛒽𕎟𓧺𞞽𜜔𗽭𕿡", "𐧲🼡𑷊𘹝𚝩𒿷𐩫𞩢𓇏", "𐧬🼣𘡌𗷯𙸫𓌷𚇜𗿑𐋵"]
    case 13:
      ["𐧦🼥👄𞖢𚪋🪦𖟥𘍺𕄨", "𐧠🼨𖆵𘯺𐁩𓦌🼶𔆘𕆢", "𐧚🼪𝂠𓪶𔪂𚓚𕑪𓯬𓡷", "𐧔🼭𔄆𛻝𙆘𝳗𘦕𑉱𜛙"]
    case 14:
      ["𐧎🼯𛋪𞣃𓮳𓮚𘈤𖛻𞦃", "𐧈🼲𒙎𘰐𒏥𕅃𙰟🠾𗭞", "𐧂🼴𙬳𗿊𜫮𕓆𘥵𚝁𗩎", "𐦼🼷𑆛𙹟𚄎𕔈𘐂𞣧𝮀"]
    case 15:
      ["𐦶🼹𘦈𜖩𖥮𘊩𐩮𝋿𙔈", "𐦰🼼𐋼𝛹𛝻𗻿𛟴𑆳𔐩", "𐦪🼾𗷹𛜡𘚒𓣤𖙃𓞘𚊟", "𐦤🽀🪁𔹹𞱡𘏢𗃯𜰷𒲌"]
    case 16:
      ["𐦞🽃𗢕𘣬𞙤𔊱𘢹𐩺𖋥", "𐦙🽅𘶁𗃰𚊣𙟨𛙦𙗗𜠈", "𐦓🽈𐹱𝿿𔝿𗵓𑕮𞉿𝠝", "𐦍🽊𙃴𗞖𑹧𙇉𐏎𑯋𔰈"]
    case 17:
      ["𐦇🽍𑔋𓆞𑷄𓒎𕖛𜠊🥱", "𐦂🽏𒻾🋸𘢘𘮐𘌌𘵈𞅔", "𐥼🽑𛗿𜔴𖨶𕈳𔣌𘘳𚺭", "𐥷🽓𝉤𑙙𛱋𘣔𑖿𘢘𚡿"]
    case 18:
      ["𐥱🽖𕱕𜤧𛹆𕑑𐮻𕼙𚮍", "𐥫🽘𞟥𐥘𕙫𖿤𞐹𔢮𓈷", "𐥦🽛𐠙𜹶𐲇𚳏𚪫𙕐𐞏", "𐥠🽝𙚤𙦤𑜌𜅡𓕸𓰏𐾞"]
    case 19:
      ["𐥛🽟𛥘𙉖𜾴🨰𑘶𝖙𝒢", "𐥕🽢𔫥𞹈🵛𘼳𗞗𜴠𚳦", "𐥐🽤𗀞🼋𘑞𒆓𔧕𐹶𐍆", "𐥋🽦𙙿𔆜𛃢𛠦𒈯𛳄𓽤"]
    case 20:
      ["𐥅🽩𒱺𒲴💶𑦔𔂒🙘𙭀", "𐥀🽫𕕨𓼀𕛥𙿑𑱷🁈𒲼", "𐤻🽭𗾁𘏄𝦵𙡨𓍻𗥫𕒼", "𐤵🽰𑧹𕳐𖙎𞭫𗏅𛊑𒸑"]
    case 21:
      ["𐤰🽲𔚩𕚄𜋾𛟏𝲸𝌨𜘆", "𐤫🽴𗒈𙡘𔬔𗟑𝩑𔗚🁙", "𐤥🽷𑎍𐺷𝱲𐭚𒪵𔩮𘭳", "𐤠🽹𔐌𑥻𘴴𜭄𗐭🧪𘮏"]
    case 22:
