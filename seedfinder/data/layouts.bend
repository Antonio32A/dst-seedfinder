      B756039Layouts.ground_tile(variant, k)
    case 757748:
      B757748Layouts.ground_tile(variant, k)
    case _:
      B762172Layouts.ground_tile(variant, k)

def ground_tile(+build: Builds.Build, +variant: U32, +k: U32) -> U32:
  match build:
    case Builds.Build{+number}:
      ground_tile_of_number(number, variant, k)
