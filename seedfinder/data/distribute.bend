    case 13:
      "𐀅񕠬񓠛񆀌񑠮򔀘𐀆񕠬񓠛񑠮񾐠񘐏񅠏𐀅񕠬񓠛񑠮񾐠񅠏𐀆񕠬񓠛񑠮򔀘񘐏񅠏𐀆񕠬񓠛񑠮񾐠񆀌񘐏𐀅񕠬񓠛񑠮񾐠񆀌𐀆񕠬񓠛񑠮񆀌򔀘񘐏𐀅񕠬񓠛񑠮񆀌򔀘𐀇񵰦񆰉񸠬򏰫񑠦򊰉񙠪𐀋񘐏񓠔񙠛񅠋񆰛񏀮񸀛񕐍񾐠񻰍񦰣𐀊񓠔񙠛񅠋񆰛񏀮񸀛񕐍񾐠񻰍񦰣𐀋񘐏񓠔񙠛񅠋񆰛񏀮񸀛񕐍򔀘񻰍񦰣𐀊񓠔񙠛񅠋񆰛񏀮񸀛񕐍򔀘񻰍񦰣𐀋񘐏񓠔񙠛񆰛񏀮񸀛񕐍񾐠񆀉񻰍񦰣𐀊񓠔񙠛񆰛񏀮񸀛񕐍񾐠񆀉񻰍񦰣𐀋񘐏񓠔񙠛񆰛񏀮񸀛񕐍񆀉򔀘񻰍񦰣𐀊񓠔񙠛񆰛񏀮񸀛񕐍񆀉򔀘񻰍񦰣𐀋񘐏񆰛񦰣񻰍񏀮񸀛񾐠񕐍񓠔񅠋񙠛𐀊񆰛񦰣񻰍񏀮񸀛񾐠񕐍񓠔񅠋񙠛𐀋񘐏񆰛񦰣񻰍򔀘񏀮񸀛񕐍񓠔񅠋񙠛𐀊񆰛񦰣񻰍򔀘񏀮񸀛񕐍񓠔񅠋񙠛𐀋񘐏񆰛񦰣񻰍񏀮񸀛񾐠񕐍񆀉񓠔񙠛𐀊񆰛񦰣񻰍񏀮񸀛񾐠񕐍񆀉񓠔񙠛𐀋񘐏񆰛񦰣񻰍򔀘񏀮񸀛񕐍񆀉񓠔񙠛𐀊񆰛񦰣񻰍򔀘񏀮񸀛񕐍񆀉񓠔񙠛𐀈񺐦񻐛񣠘񕐔񦰦񘐔񻰠񺠦𐀈񺐦񻐛񣠘񙀛񕐔񦰦񻰠񺠦𐀈񘐔񻐛񣠘񕐔񺠦񺐦񻰠񦰦𐀈񻐛񣠘񙀛񕐔񺠦񺐦񻰠񦰦𐀆񾠦񬰦񺰦񫀦񋐚񪠦𐀋񎰤񸠤񡠠񉠧񐰠򑀤񑐚񕐠񢀠񑀠򔐚𐀋񎰤񸠤񐰠񉠧򔐚񑀠񑐚񢀠񕐠򑀤񡠠"
    case 14:
      "𐀇񫐘񪠘񬰏񺰔񫀛񋐘񾠛𐀈񫐘񪠘򔐔񬰏񺰔񫀛񋐘񾠛𐀇񾠛񺰔񫐘񪠘񫀛񋐘񬰏𐀈񾠛񺰔򔐔񫐘񪠘񫀛񋐘񬰏𐀍񎰤񐠠񐰠񉠨񪠠񑀠񸠤񕐠񬰛񢀦򔐠򑀦񬠔𐀍񎰤񐠠񪠠񉠨񬠔򑀦򔐠񢀦񕐠񬰛񸠤񑀠񐰠𐀈񾠦񫐠񪠨񫀦񋐦񬰠򔐠񺰦𐀈񾠦񫐠񪠨񫀦񋐦񬰠򔐦񺰦𐀈񾠦񫐠񪠨񫀦񋐦񬰠񺰦򔐠𐀈񾠦񫐠񪠨񫀦񋐦񬰠񺰦򔐦𐀉񢀔񬠘񪠠񕐔񬰦񮀔񻠘񡰘񡠟𐀉񢀔񬠘񡠟񡰘񬰦񮀔񻠘񕐔񪠠𐀆񘐔񆰏񑠮񾐥񓠠񙠏𐀅񆰏񑠮񾐥񓠠񙠏𐀇񘐔񆰏򔐐񑠮񓠠򔀥񙠏𐀆񆰏򔐐񑠮񓠠򔀥񙠏𐀇񘐔񆰏񑠮񾐥񆀏񓠠񙠏𐀆񆰏񑠮񾐥񆀏񓠠񙠏𐀈񘐔񆰏򔐐񑠮񆀏񓠠򔀥񙠏𐀇񆰏򔐐񑠮񆀏񓠠򔀥񙠏𐀆񘐔񓠠񑠮񾐥񆰏񙠏𐀅񓠠񑠮񾐥񆰏񙠏𐀇񘐔񓠠򔐐񑠮򔀥񆰏񙠏𐀆񓠠򔐐񑠮򔀥񆰏񙠏𐀇񘐔񓠠񑠮񾐥񆀏񆰏񙠏𐀆񓠠񑠮񾐥񆀏񆰏񙠏𐀈񘐔񓠠򔐐񑠮񆀏򔀥񆰏񙠏𐀇񓠠򔐐񑠮񆀏򔀥񆰏񙠏𐀈񘐥񑠦񋠠񕠞񕐔񵠉񾐥񅠠𐀇񑠦񋠠񕠞񕐔񵠉񾐥񅠠𐀈񘐥򔀜񑠦񋠠񕠞񕐔񵠉񅠠𐀇򔀜񑠦񋠠񕠞񕐔񵠉񅠠"
    case 15:
      "𐀈񘐥񑠦񋠠񕠞񕐔񆀚񵠉񾐥𐀇񑠦񋠠񕠞񕐔񆀚񵠉񾐥𐀈񘐥򔀜񑠦񋠠񕠞񕐔񆀚񵠉𐀇򔀜񑠦񋠠񕠞񕐔񆀚񵠉𐀈񵠉񑠦񋠠񕠞񕐔񘐥񾐥񅠠𐀇񵠉񑠦񋠠񕠞񕐔񾐥񅠠𐀈񵠉򔀜񑠦񋠠񕠞񕐔񘐥񅠠𐀇񵠉򔀜񑠦񋠠񕠞񕐔񅠠𐀈񵠉񑠦񋠠񕠞񕐔񆀚񘐥񾐥𐀇񵠉񑠦񋠠񕠞񕐔񆀚񾐥𐀈񵠉򔀜񑠦񋠠񕠞񕐔񆀚񘐥𐀇񵠉򔀜񑠦񋠠񕠞񕐔񆀚𐀄񈀦񥰙񐠫񉰮𐀄񐠫񥰙񈀦񉰮𐀁򘐦𐀄񈰦񈠦򀐦񉀦𐀃򀐦򀰒򖰎𐀃򁀔򀐦񱀑𐀂񘐏񅠏𐀁񅠏𐀂񘐏񆀌𐀁񆀌𐀂񆀌񘐏𐀄񷀚񘐠񺐏񙠇𐀃񘐯񕠮񾐦𐀂񕠮񾐦𐀃񘐯򔀟񕠮𐀂򔀟񕠮𐀆񺐩񻐦򏐔򊰉񆰃񺠩𐀇񺐩񻐦򏐔򊰉񆰃񙀛񺠩𐀄񺐩񊰔񆰃񺠩𐀅񳠉񥠔񣠨򏰦񣰩"
    case 16:
      "𐀃񺐦񻰦񺠦𐀃񺐦񺠦񻰦𐀇񘐘񕠕񕐏񑠛񋠏񾐘񵠇𐀆񕠕񕐏񑠛񋠏񾐘񵠇𐀇񘐘򔀑񕠕񕐏񑠛񋠏񵠇𐀆򔀑񕠕񕐏񑠛񋠏񵠇𐀇񕠕񵠇񕐏񑠛񋠏񾐘񘐘𐀆񕠕񵠇񕐏񑠛񋠏񾐘𐀇񕠕򔀑񵠇񕐏񑠛񋠏񘐘𐀆񕠕򔀑񵠇񕐏񑠛񋠏𐀂񘐒񕠅𐀁񕠅𐀄񺐦򏐛񺠦񕐠𐀄񺐦񕐠񺠦򏐛𐀄񘐩񕠮񄠦򖀦𐀃񕠮񄠦򖀦𐀄񕠮򖀦񄠦񘐩𐀃񕠮򖀦񄠦"
    case _:
      ""

def variants(+i: U32) -> List<&2, U32>:
  B.row(variants_chunk((i >> 5n : U32)), (i .&. 31 : U32))

# Row 0: (land tile, tile class) pairs, tiles ascending; pickspawnprefab filters equally on one class.
def tile_classes_count() -> U32:
  1

def tile_classes_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐂈𐀂𐀀𐀃𐀁𐀄𐀂𐀅𐀃𐀆𐀄𐀇𐀄𐀈𐀅𐀊𐀀𐀋𐀀𐀌𐀀𐀍𐀆𐀎𐀆𐀏𐀆𐀐𐀆𐀑𐀆𐀒𐀆𐀓𐀆𐀔𐀆𐀕𐀆𐀖𐀆𐀗𐀆𐀘𐀆𐀙𐀆𐀞𐀆𐀟𐀇𐀠𐀀𐀡𐀆𐀢𐀆𐀣𐀆𐀤𐀈𐀥𐀉𐀦𐀆𐀧𐀆𐀩𐀆𐀪𐀊𐀫𐀋𐀬𐀆𐀭𐀀𐀮𐀆𐀯𐀆𐁸𐀆𐁹𐀆𐁺𐀆𐁻𐀆𐁼𐀆𐁽𐀆𐁾𐀆𐁿𐀆𐄀𐀆𐄁𐀆𐄂𐀆𐄃𐀆𐄄𐀆𐄅𐀀𐄆𐀀𐄇𐀌𐄈𐀆𐄉𐀆𐄊𐀆𐄋𐀆𐄌𐀆𐄍𐀆𐄎𐀆𐄏𐀆𐄐𐀆𐄑𐀆𐄒𐀆𒄁𐀆"
    case _:
      ""

def tile_classes(+i: U32) -> List<&2, U32>:
  B.row(tile_classes_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def tile_class_count() -> U32:
  13

# Row i of level ocean_population: room, tile, then pickspawnprefab's items order for that tile, one unit per entry as in variants (PopulateWaterType uses the depth-1 distributeprefabs directly).
def ocean_picks_count() -> U32:
  5

def ocean_picks_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀃𐀴𐃊򘐦𐀆𐀳𐃉񈀦񥰙񐠫񉰮𐀅𐀷𐃋򁀔򀐦񱀑𐀅𐀶𐃌򀐦򀰒򖰎𐀆𐀵𐃏񈰦񈠦򀐦񉀦"
    case _:
      ""

def ocean_picks(+i: U32) -> List<&2, U32>:
  B.row(ocean_picks_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def swappable_count(+room: U32, +depth: U32) -> U32:
  B.at(cases((((room * 2 : U32) + depth : U32) - 1 : U32)), 0)

# The variant for a room, depth and case index (see above).
def variant(+room: U32, +depth: U32, +index: U32) -> U32:
  +row = cases((((room * 2 : U32) + depth : U32) - 1 : U32))
  B.at(row, (((B.at(row, 0) * 2 : U32) + 1 : U32) + index : U32))

def tile_class_pick(hit: Bool, +c: U32, +found: U32) -> U32:
  match hit:
    case True{}:
      c
    case False{}:
      found

def tile_class_scan(xs: List<&2, U32>, +tile: U32, +found: U32) -> U32:
  match xs:
    case Nil{}:
      found
    case Con{+t, Nil{}}:
      found
    case Con{+t, Con{+c, rest}}:
      tile_class_scan(rest, tile, tile_class_pick(U32.is_eq(t, tile), c, found))

# The prefab string id of a variants / ocean_picks unit.
def entry_prefab(+u: U32) -> U32:
  (u >> 10n : U32)

# The weight id (data/rooms.bend) of a variants / ocean_picks unit.
def entry_weight(+u: U32) -> U32:
  (u .&. 1023 : U32)

# The pickspawnprefab tile class of a land tile (NONE for other tiles).
def tile_class(+tile: U32) -> U32:
  tile_class_scan(tile_classes(0), tile, 1048575)
