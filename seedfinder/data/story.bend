# TileGroupManager:IsImpassableTile for tile values below 1024: IMPASSABLE and the legacy range.
def impassable_value() -> U32:
  1

def legacy_impassable_first() -> U32:
  128

def legacy_impassable_last() -> U32:
  200

# math.random() < 0.5 holds exactly when the PCG output is below this.
def half_threshold() -> U32:
  2147483648

# Rooms storygen names directly: SeperateStoryByBlanks' and LinkRegions' graph backgrounds.
def bg_impassable_room() -> U32:
  4

def region_link_room() -> U32:
  47

def piece_key(+key: U32) -> U32:
  Blob.at(piece_keys(key), 0)

def piece_key_layout(+key: U32) -> U32:
  Blob.at(piece_keys(key), 1)

def piece_special(+code: U32) -> U32:
  Blob.at(piece_specials(code), 0)

def piece_special_layout(+code: U32) -> U32:
  Blob.at(piece_specials(code), 1)

def is_impassable(+tile: U32) -> Bool:
  U32.is_eq(tile, impassable_value()) || ((tile >= legacy_impassable_first() : U32) && (tile <= legacy_impassable_last() : U32))
