      "𐀄𓿰𐀀𐀀𐀀𐀄𓿰𕦰𝌕𘕴𐀄𓿰𛕘𖳹𘤏𐀄𓿱𑌁𝀒𕭑"
    case 1:
      "𐀄𓿱𗊸𓱽𕅻𐀄𓿱𝒇𓅨𛦪𐀄𓿲𓡺𖹵𖈸𐀄𓿲𙺝🔟𝻡"
    case 2:
      "𐀄𓿳𐛾𐨱𛜕𐀄𓿳𗆧𓜺𚧋𐀄𓿳𝺦𔰒𓐢𐀄𓿴𔸈𖁡𘤭"
    case 3:
      "𐀄𓿴𛿚𝔶𒨧𐀄𓿵𓐫𕚝𔾂𐀄𓿵𚬇𝵈𕐩𐀄𓿶𒑾𛀺𕖅"
    case 4:
      "𐀄𓿶𚂞𖙿𓯍𐀄𓿷𑽵𞣬𕽴𐀄𓿷𚄔𗏫𐆇𐀄𓿸𒖉𙥌𜸓"
    case 5:
      "𐀄𓿸𚳥𔈪𚃛𐀄𓿹𓜷𛃍𜗥𐀄𓿹𜒑𘊣🂐𐀄𓿺𕔃𛈾𒕝"
    case 6:
      "𐀄𓿺𞢟𙥚𝎭𐀄𓿻𗽶🋻𕹇𐀄𓿼𑦛𝶅𕊜𐀄𓿼𛜠𝳯𙁩"
    case 7:
      "𐀄𓿽𕠘𝳻𚒇𐀄𓿽🲗𓍻𙭟𐀄𓿾𚒯𚊤𙃚𐀄𓿿𕁶𕭮𔕀"
    case _:
      ""

def win_exp2_tab(+i: U32) -> List<&2, U32>:
  Blob.row(win_exp2_tab_chunk((i >> 2n : U32)), (i .&. 3 : U32))

# (float)pow(e, -val) bits for val = -3..7, at row val + 3.
def maze_exponent_tab_chunk(+c: U32) -> String:
  match c:
    case 0:
      "𐀂𔆠𚼮𐀂𔃬𗌦𐀂𔀭🡔𐀂𓾀𐀀"
    case 1:
      "𐀂𓺼𕪲𐀂𓸊𙕕𐀂𓵋𞶆𐀂𓲖𐪮"
    case 2:
      "𐀂𓯜𜧿𐀂𓬢𗊐𐀂𓩯𐭝"
    case _:
      ""

def maze_exponent_tab(+i: U32) -> List<&2, U32>:
  Blob.row(maze_exponent_tab_chunk((i >> 2n : U32)), (i .&. 3 : U32))
