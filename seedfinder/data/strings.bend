def strings(+i: U32) -> List<&2, U32>:
  Blob.row(strings_chunk((i >> 5n : U32)), (i .&. 31 : U32))

def strings_at(+i: U32, +j: U32) -> U32:
  Blob.row_at(strings_chunk((i >> 5n : U32)), (i .&. 31 : U32), j)

