   15872, 268435424, 7936, 67108848, 4032, 16777208, 2032, 2097136, 504, 131008, 4, 0, 0, 0, 0]

def area_at(+masses: Landmass.Masses, +tile: U32) -> U32:
  Islands.mass_area(masses, Landmass.mass_at(masses, tile))

law cut_off_piece_of_seed_149:
  {area_at(Landmass.of_land(crop(), 63, 57), 2498) == 1920 : U32}

