# A mainland piece cut off by water (docs/config.md section 4 G): on Windows forest seed 149 of build 762172 the
# moon island's REGION_LINK ocean cells wrap round Forest hunters 4-6, and the piece holding them (with walrus_camp 3
# at (-470.98, 425.53), tile (41, 39) below) is 1920 tiles, the mainland 48475. Golden: the land bits of the dump's
# tiles cropped to the piece's bounds and one tile of water around them (63 x 57), and its 4-neighbour flood (Python).

def crop() -> List<&2, U32>:
  [0, 0, 4026531840, 8192, 2147467264, 12288, 2147483520, 7168, 1073741760, 1792, 2684354528, 16368, 2147483632, 8184,
   2147483640, 4088, 67108860, 2046, 2181038078, 3221226495, 3791650815, 4026532351, 4177526783, 4227858943,
   4278190079, 4278190591, 4294967295, 4290773503, 4294967295, 4293919231, 4294967295, 4294443519, 4294967295,
   4294836735, 4294967295, 4294902271, 4294967295, 4294951423, 4294967295, 4294951423, 4294967295, 4294951423,
   4294967295, 4294951167, 4294967295, 4294951039, 4294967295, 4294950975, 4294967295, 4294950919, 4294967295,
   4294950913, 2147483647, 4294934528, 268435455, 4294934528, 67108863, 4294934528, 16777215, 4294934528, 2097151,
   4294934528, 524287, 4294934528, 131071, 4294934528, 16383, 4294934528, 8191, 4294934528, 4095, 4294934528, 2047,
