import Base
import ../f32/powf.bend as Powf
import ../rng/pcg.bend as Pcg
import ../worldsim/cave/growing.bend as CaveGrowing
import ../lawkit/cave_grid.bend as CaveGrid

# Golden values of the growing tree on explicit grids, from the native reconstruction of WorldSim's RunMaze that
# reproduces the real dedicated server (build 747465, see cave_kernels.bend). The Windows variant differs by MSVCR90's
# powf.

# The first n cells of an array, the packed dead ends and the PCG state.
type Grown is Data:
  Grown{cells: List<&2, U32>, dead: List<&2, U32>, rng: Pcg.Rng}

def grown_out(g: CaveGrowing.Grown, +n: U32) -> Grown:
  match g:
    case CaveGrowing.Grown{cells, dead, rng}:
      Grown{CaveGrid.read(cells, n), dead, rng}

# The growing tree (type 3, val 2, linux) over a 10 x 10 maze grid sampled to 5 x 5 cells; a cell is lo | hi << 8.
law growing_tree_linux:
  {grown_out(CaveGrowing.grow(False{}, CaveGrid.grid([52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994], 10, 10), 10, 5, 5, 2, Powf.maze_exponent(2), True{}, Pcg.srandom(11)), 100) == Grown{[52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36610, 36610, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36610, 36610, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36610, 36610, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36610, 36610, 36609, 36609, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994], [131074], Pcg.Rng{3787306261, 3936394155}} : Grown}

def growing_tree_linux():
  {==}

# The growing tree (type 3, val 2, windows) over a 10 x 10 maze grid sampled to 5 x 5 cells; a cell is lo | hi << 8.
law growing_tree_windows:
  {grown_out(CaveGrowing.grow(True{}, CaveGrid.grid([52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 36612, 36612, 36612, 36612, 36612, 36612, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994], 10, 10), 10, 5, 5, 2, Powf.maze_exponent(2), True{}, Pcg.srandom(11)), 100) == Grown{[52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36609, 36609, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36610, 36610, 52994, 52994, 52994, 52994, 36609, 36609, 36609, 36609, 36610, 36610, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994, 52994], [], Pcg.Rng{2932654950, 1425187230}} : Grown}

def growing_tree_windows():
  {==}
