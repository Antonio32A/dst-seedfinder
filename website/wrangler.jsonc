{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "dst-seedfinder",
    "compatibility_date": "2026-09-23",
    "main": "./worker/index.ts",
    "assets": {
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS"
    },
    "images": {
        "binding": "IMAGES"
    },
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "dst-seedfinder",
            "migrations_dir": "migrations"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "JOB_ROOM",
                "class_name": "JobRoom"
            },
            {
                "name": "DISPATCHER",
                "class_name": "Dispatcher"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "JobRoom",
                "Dispatcher"
            ]
        }
    ],
    "triggers": {
        "crons": [
            "*/5 * * * *"
        ]
    },
    "secrets": {
        "required": [
            "DISCORD_CLIENT_ID",
            "DISCORD_CLIENT_SECRET"
        ]
    }
}
