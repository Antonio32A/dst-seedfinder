{
    "name": "dst-seedfinder",
    "version": "0.1.0",
    "private": true,
    "packageManager": "npm@10.9.8",
    "dependencies": {
        "@vinext/cloudflare": "1.0.0-beta.9",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-server-dom-webpack": "19.3.0",
        "vinext": "1.0.0-beta.11"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.58.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.6.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitejs/plugin-rsc": "0.5.35",
        "msw": "2.15.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.2",
        "wrangler": "4.137.0"
    },
    "type": "module",
    "scripts": {
        "wasm": "mkdir -p public/wasm && cp ../build/wasm/seedfinder.wasm ../build/wasm/seedfinder.mjs public/wasm/",
        "predev": "npm run wasm --silent || echo 'No ../build/wasm yet, so browser search is off. Build it with ../scripts/build.sh wasm.'",
        "dev": "vinext dev",
        "prebuild": "npm run wasm",
        "build": "vinext build",
        "start": "wrangler dev --config dist/server/wrangler.json",
        "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
        "preview": "npm run build && npm run start --",
        "test": "vinext build && vitest run",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
    }
}
