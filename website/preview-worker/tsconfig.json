{
    "compilerOptions": {
        "target": "ES2024",
        "lib": [
            "esnext"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": [
            "./worker-configuration.d.ts"
        ],
        "paths": {
            "@/*": [
                "../*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "worker-configuration.d.ts"
    ]
}
