{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dst-seedfinder-preview",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "seedfinder.antonio32a.com/og/*",
			"zone_name": "antonio32a.com"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"limits": {
		"cpu_ms": 60000
	},
	"vars": {
		"PREVIEW_ORIGIN": "https://seedfinder.antonio32a.com",
		"BROWSER_KEEP_ALIVE_MS": "120000"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"r2_buckets": [
		{
			"binding": "PREVIEWS",
			"bucket_name": "dst-seedfinder-previews"
		}
	],
	"ratelimits": [
		{
			"name": "RENDER_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MAP_RENDERER",
				"class_name": "MapRenderer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MapRenderer"
			]
		}
	]
}